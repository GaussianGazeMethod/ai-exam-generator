# AI 试题生成系统 - 环境变量模板
# 复制此文件为 .env 并填入真实密钥（.env 已被 .gitignore 排除，不会提交到 Git）

# ========== DeepSeek（AI 出题主力模型）==========
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========== 阿里 DashScope MaaS（专用端点，向量嵌入）==========
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# ========== 数据库 ==========
DATABASE_URL=sqlite+aiosqlite:///./app.db

# ========== 安全 ==========
SECRET_KEY=change-me-to-a-random-string-in-production

# ========== 应用 ==========
APP_NAME=AI试题生成系统
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# SQL 语句回显（排查 ORM 问题时临时开启）
SQL_ECHO=false

# 对外访问基地址（用于生成考试二维码的绝对 URL）
# 开发环境可用 http://localhost:5174（移动答题端）
# 生产环境必须配置为对外域名，否则内网地址生成的二维码考生扫不开
PUBLIC_BASE_URL=
